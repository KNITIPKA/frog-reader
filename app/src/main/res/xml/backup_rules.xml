<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for Android 11 and below. Android 12+ reads
   data_extraction_rules.xml instead, so any change here needs a matching change
   there.

   Auto Backup has a 25 MB quota per app and drops the WHOLE backup when
   exceeded, so only irreplaceable user data (the SQLite database, DataStore
   preferences, and user-imported custom fonts) is included here.
-->
<full-backup-content>
    <!-- Primary SQLite database (books, shelves, quotes, bookmarks, queue, log, stats, achievements). -->
    <include domain="file" path="databases/frogreader.db"/>
    <include domain="file" path="databases/frogreader.db-wal"/>
    <!-- DataStore Preferences: reader and app settings (including profile avatar). -->
    <include domain="file" path="datastore/"/>
    <!-- User-imported custom fonts. -->
    <include domain="file" path="fonts/"/>

    <!-- Transient SQLite shared-memory / rollback files must never be restored. -->
    <exclude domain="file" path="databases/frogreader.db-shm"/>
    <exclude domain="file" path="databases/frogreader.db-journal"/>
    <exclude domain="file" path="databases/frogreader.db.pre_restore_bak"/>
</full-backup-content>
