<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Unlocking the app. A normal permission: granted at install, never asked for. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
        READ_EXTERNAL_STORAGE is deliberately absent, and must stay absent.

        It was declared here and never once requested at runtime. On API 26-32
        that is a dangerous permission, so declaring it alone granted nothing
        and the scan it was meant to serve silently returned nothing; from 33
        it is not a thing at all under scoped storage. Every file the app reads
        now comes through the Storage Access Framework, which needs no
        permission because the user picks the file or folder themselves.

        Adding it back would put a storage permission on the Play listing that
        the app does not use.
    -->

    <!--
        WorkManager (pulled in by the home-screen widget through Glance) merges
        FOREGROUND_SERVICE into the manifest. Nothing here ever runs one: the
        only worker is a plain periodic backup, with no setExpedited and no
        setForeground. Left in, targetSdk 36 requires a foreground service type
        to be declared and justified in the Play Console for a service the app
        never starts.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <application
        android:name=".FrogReaderApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FrogReader">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.FrogReader.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open EPUB/FB2/MOBI files from file managers -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/x-fictionbook+xml" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/x-mobipocket-ebook" />
                <data android:mimeType="application/vnd.amazon.ebook" />
                <data android:mimeType="application/vnd.amazon.mobi8-ebook" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.ContinueReadingWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_continue_reading" />
        </receiver>
    </application>

</manifest>
