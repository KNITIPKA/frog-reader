# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# Room (WorkManager uses androidx.room; FrogReader uses androidx.room3)
# instantiates its generated *_Impl database classes reflectively.
-keep class * extends androidx.room.RoomDatabase {
    <init>();
}
-keep class * extends androidx.room3.RoomDatabase {
    <init>();
}

# WorkManager builds InputMergers by class name. R8 keeps the classes — the
# library's own consumer rules do that — but strips their no-argument
# constructors, because nothing in the app ever calls one:
#   E WM-InputMerger: java.lang.InstantiationException:
#   androidx.work.OverwritingInputMerger has no zero argument constructor
# Glance schedules every widget update through WorkManager, so this fired on
# each launch of a release build and the widget stopped refreshing.
-keep class * extends androidx.work.InputMerger {
    <init>();
}
-keep class * extends androidx.work.ListenableWorker {
    <init>(...);
}

# Additional project-level safeguard for the persisted model entry points.
# This is NOT the complete serialization configuration: kotlinx-serialization-
# core supplies annotation-based consumer rules for retained @Serializable
# classes in every package, including data.ReaderSettings, data.AppSettings
# and data.ReadingStats. Direct Foo.serializer() calls are also visible to R8.
# Do not broaden this rule just because a serializable type is outside model;
# check the merged release configuration and actual lookup path first.
# https://github.com/Kotlin/kotlinx.serialization#android
-keepclassmembers class com.example.frogreader.data.model.** {
    *** Companion;
    kotlinx.serialization.KSerializer serializer(...);
}
-keep class com.example.frogreader.data.model.FirstLaunchState { *; }
-keep class com.example.frogreader.data.model.FirstLaunchState$$serializer { *; }

# PDFium registers these JNI classes by their literal names in JNI_OnLoad.
# Its 2.0.3 AAR supplies no consumer rules, so retain every registered entry point,
# including Kotlin companion/static bridges, in optimized release builds.
-keep class io.legere.pdfiumandroid.core.jni.** { *; }
# FindClass/ThrowNew and native callbacks also refer to these literal type/member names.
-keep class io.legere.pdfiumandroid.api.PdfPasswordException { <init>(...); }
-keep interface io.legere.pdfiumandroid.api.PdfWriteCallback { *; }
-keep class io.legere.pdfiumandroid.core.util.PdfiumNativeSourceBridge { *; }

# Rust exports JNI methods with this literal class/member name.
-keep class com.example.frogreader.engine.RustNative {
    native <methods>;
}
-keep class com.example.frogreader.engine.RustChunkedCacheNative {
    native <methods>;
}
-keep class com.example.frogreader.engine.RustPageIndexNative {
    native <methods>;
}
-keep class com.example.frogreader.engine.RustEpubZipNative {
    native <methods>;
}
-keep class com.example.frogreader.engine.RustEpubPackageNative {
    native <methods>;
}
-keep class com.example.frogreader.engine.RustCssSyntaxNative {
    native <methods>;
}
-keep class com.example.frogreader.data.parser.RustCssMatchNative {
    native <methods>;
}
-keep class com.example.frogreader.data.parser.RustCssSelectorsNative {
    native <methods>;
}
-keep class com.example.frogreader.data.parser.RustCssValuesNative {
    native <methods>;
}
-keep class com.example.frogreader.data.parser.RustCssComputedNative {
    native <methods>;
}
-keep class com.example.frogreader.data.parser.RustChapterMarkupNative {
    native <methods>;
}
-keep class com.example.frogreader.engine.RustMobiNative {
    native <methods>;
}
-keep class com.example.frogreader.engine.RustFb2TxtNative {
    native <methods>;
}
-keep class com.example.frogreader.engine.RustSearchNative {
    native <methods>;
}
-keep class com.example.frogreader.engine.RustWoffNative {
    native <methods>;
}
