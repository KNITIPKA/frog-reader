# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# Room (used by WorkManager, which Glance widgets depend on) instantiates its
# generated *_Impl database classes reflectively.
-keep class * extends androidx.room.RoomDatabase {
    <init>();
}

# WorkManager builds InputMergers by class name. R8 keeps the classes — the
# library's own consumer rules do that — but strips their no-argument
# constructors, because nothing in the app ever calls one:
#   E WM-InputMerger: java.lang.InstantiationException:
#   androidx.work.OverwritingInputMerger has no zero argument constructor
# Glance schedules every widget update through WorkManager, so this fired on
# each launch of a release build and the widget stopped refreshing.
-keep class * extends androidx.work.InputMerger {
    <init>();
}
-keep class * extends androidx.work.ListenableWorker {
    <init>(...);
}

# Additional project-level safeguard for the persisted model entry points.
# This is NOT the complete serialization configuration: kotlinx-serialization-
# core supplies annotation-based consumer rules for retained @Serializable
# classes in every package, including data.ReaderSettings, data.AppSettings
# and data.ReadingStats. Direct Foo.serializer() calls are also visible to R8.
# Do not broaden this rule just because a serializable type is outside model;
# check the merged release configuration and actual lookup path first.
# https://github.com/Kotlin/kotlinx.serialization#android
-keepclassmembers class com.example.frogreader.data.model.** {
    *** Companion;
    kotlinx.serialization.KSerializer serializer(...);
}
