<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name="com.example.frogreader.data.translation.fixtures.ProcessOnlyFixture"
            android:exported="true" android:label="Fixture generic text processor">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity android:name="com.example.frogreader.data.translation.fixtures.DictionaryFixture"
            android:exported="true" android:label="Fixture dictionary">
            <intent-filter>
                <action android:name="aard2.lookup" />
                <action android:name="colordict.intent.action.SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name="com.example.frogreader.data.translation.fixtures.SecondDictionaryFixture"
            android:exported="true" android:label="Fixture second dictionary activity">
            <intent-filter>
                <action android:name="android.intent.action.DEFINE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name="com.example.frogreader.data.translation.fixtures.QuickDicFixture"
            android:exported="true" android:label="Fixture QuickDic">
            <intent-filter>
                <action android:name="com.hughes.action.ACTION_SEARCH_DICT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name="com.example.frogreader.data.translation.fixtures.ForaFixture"
            android:exported="true" android:label="Fixture Fora">
            <intent-filter>
                <action android:name="com.ngc.fora.action.LOOKUP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name="com.example.frogreader.data.translation.fixtures.TypedDictionaryFixture"
            android:exported="true" android:label="Fixture typed dictionary">
            <intent-filter>
                <action android:name="android.intent.action.DEFINE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity android:name="com.example.frogreader.data.translation.fixtures.SearchFixture"
            android:exported="true" android:label="Fixture browser">
            <intent-filter>
                <action android:name="android.intent.action.WEB_SEARCH" />
                <action android:name="android.intent.action.SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name="com.example.frogreader.data.translation.fixtures.SearchOnlyFixture"
            android:exported="true" android:label="Fixture local search">
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name="com.example.frogreader.data.translation.fixtures.KiwixFixture"
            android:exported="true" android:label="Fixture offline reader">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kiwix" android:host="search" />
            </intent-filter>
        </activity>
        <activity android:name="com.example.frogreader.data.translation.fixtures.KiwixUriOnlyFixture"
            android:exported="true" android:label="Fixture URI without text support">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kiwix" android:host="search" />
            </intent-filter>
        </activity>
        <activity android:name="com.example.frogreader.data.translation.fixtures.DisabledFixture"
            android:exported="true" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.DEFINE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name="com.example.frogreader.data.translation.fixtures.PrivateFixture"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DEFINE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name="com.example.frogreader.data.translation.fixtures.PermissionFixture"
            android:exported="true" android:permission="android.permission.MANAGE_USERS">
            <intent-filter>
                <action android:name="android.intent.action.DEFINE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
